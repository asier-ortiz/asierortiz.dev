---
import type { CollectionEntry } from 'astro:content';
import PostImage from '@/components/Media/PostImage.astro';
import SearchButton from '@components/Blog/SearchButton.vue';
import Pagination from '@components/Blog/Pagination.astro';
import Button from '@/components/Button/Button.astro';
import siteData from '@config/siteData.json';
import { getReadingTime } from '@/utils/readingTime';
import { formatDate } from '@/utils/formatDate';
import type { PaginationInfo } from '@/utils/posts';

type Post = CollectionEntry<'blog'>;

interface Props {
  /** Every published post: feeds the search index and the tag chips. */
  allPosts: Post[];
  /** The posts rendered on this page. */
  posts: Post[];
  pagination?: PaginationInfo;
  /** Set on /blog/tag/<tag>/ pages. */
  activeTag?: string;
}

const { allPosts, posts, pagination, activeTag } = Astro.props;

const allTags = Array.from(new Set(allPosts.flatMap((post) => post.data.tags || []))).sort(
  (a, b) => a.localeCompare(b)
);

// While everything fits on one page the chips filter the grid in place, as
// they always have. Once the archive is paginated an in-page filter would only
// see the cards of the current page, so the chips become links to tag pages.
const paginated = (pagination?.lastPage ?? 1) > 1;
const chipsAreLinks = paginated || !!activeTag;

const searchIndex = allPosts.map((post) => ({
  title: post.data.title || '',
  description: post.data.description || '',
  url: `/blog/${post.slug}/`,
  pubDate: post.data.pubDate,
  tags: post.data.tags ?? [],
}));
---

<section class="mx-auto max-w-3xl px-6 pt-24 md:pt-36 lg:pt-44">
  <header class="blog-header text-left mb-12">
    <h1 class="h1 text-pretty text-gradient pb-2">Between commits</h1>
    <p class="description mt-6 text-pretty">
      Posts about web, mobile and AI. Mostly notes from projects, things that broke, things I figured out along the way.
      <Button
        variant="link"
        href={siteData.newsletter.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={siteData.newsletter.label}
        class="inline"
      >
        Subscribe now.
      </Button>
    </p>
  </header>

  <!-- Search Button & Tag Filter Buttons -->
  {
    allTags.length > 0 && (
      <div id="tag-filters" class="blog-filters flex flex-wrap gap-2 mb-12 items-center max-h-[6rem] overflow-y-auto hide-scrollbar p-1">
        <SearchButton client:only="vue" posts={searchIndex} language={siteData.language} />

        {chipsAreLinks ? (
          <>
            <a
              href="/blog/"
              class:list={['button button--chip', { 'button--chip-active': !activeTag }]}
              aria-current={!activeTag ? 'page' : undefined}
            >
              Show All
            </a>
            {allTags.map((tag) => (
              <a
                href={`/blog/tag/${tag}/`}
                class:list={['button button--chip', { 'button--chip-active': activeTag === tag }]}
                aria-current={activeTag === tag ? 'page' : undefined}
              >
                #{tag}
              </a>
            ))}
          </>
        ) : (
          <>
            <button type="button" class="button button--chip filter-btn" data-tag="all">
              Show All
            </button>
            {allTags.map((tag) => (
              <button type="button" class="button button--chip filter-btn" data-tag={tag}>
                #{tag}
              </button>
            ))}
          </>
        )}
      </div>
    )
  }

  {
    activeTag ? (
      <p class="text-sm text-base-400 mb-6" role="status">
        {posts.length} {posts.length === 1 ? 'post' : 'posts'} tagged #{activeTag}
      </p>
    ) : (
      pagination && pagination.currentPage > 1 && (
        <p class="text-sm text-base-400 mb-6" role="status">
          Page {pagination.currentPage} of {pagination.lastPage}
        </p>
      )
    )
  }

  <!-- Posts List -->
  <div id="posts-grid" class="grid gap-10 grid-cols-1 md:grid-cols-2">
    {
      posts.map((post) => {
        const readingDuration = getReadingTime(post.body);
        return (
          <a
            href={`/blog/${post.slug}/`}
            class="post-card group block overflow-hidden rounded-2xl border border-base-700 bg-base-900 hover:border-primary-500 hover:shadow-xl hover:scale-[1.02] active:border-primary-500 transform transition-all duration-300"
            data-tags={post.data.tags?.join(',')}
          >
            <PostImage src={post.data.image} alt={`Cover image for ${post.data.title}`} />

            <div class="p-6">
              <h2 class="text-2xl font-semibold mb-2 underline-ltr">{post.data.title}</h2>

              <div class="flex flex-wrap items-center gap-2 text-base-400 text-sm mb-4">
                <time
                  datetime={post.data.pubDate.toISOString()}
                  data-relative-limit="7"
                  title={formatDate(post.data.pubDate, siteData.language)}
                >
                  {formatDate(post.data.pubDate, siteData.language)}
                </time>
                <span>·</span>
                <span>{readingDuration}</span>
                {post.data.author && (
                  <>
                    <span>·</span>
                    <span>By {post.data.author}</span>
                  </>
                )}
              </div>

              {post.data.tags && (
                <div class="flex flex-wrap gap-2 mb-4">
                  {post.data.tags.map((tag) => (
                    <span class="bg-primary-100 text-primary-800 text-xs px-2 py-1 rounded-full">
                      #{tag}
                    </span>
                  ))}
                </div>
              )}

              <p class="text-base-300 line-clamp-3">{post.data.description}</p>
            </div>
          </a>
        );
      })
    }
  </div>

  <Pagination pagination={pagination} />

  <script>
    document.querySelectorAll<HTMLTimeElement>('time[data-relative-limit]').forEach((el) => {
      const date = new Date(el.dateTime);
      const limit = parseInt(el.dataset.relativeLimit || '7');
      const diffMs = Date.now() - date.getTime();
      const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

      if (diffDays <= limit) {
        const rtf = new Intl.RelativeTimeFormat(document.documentElement.lang || 'en', {
          numeric: 'auto',
        });

        if (diffDays > 0) {
          el.textContent = rtf.format(-diffDays, 'day');
        } else {
          const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
          if (diffHours > 0) {
            el.textContent = rtf.format(-diffHours, 'hour');
          } else {
            const diffMinutes = Math.max(1, Math.floor(diffMs / (1000 * 60)));
            el.textContent = rtf.format(-diffMinutes, 'minute');
          }
        }
      }
    });
  </script>

  <!-- Posts filtering with tag highlight (single-page archive only) -->
  {
    !chipsAreLinks && (
      <script is:inline>
        const tagButtons = document.querySelectorAll('.filter-btn');
        const posts = document.querySelectorAll('#posts-grid .post-card');

        tagButtons.forEach((button) => {
          button.addEventListener('click', () => {
            const selectedTag = button.dataset.tag;

            // Highlight only selected button
            tagButtons.forEach((btn) => {
              btn.classList.remove('button--chip-active');
            });

            button.classList.add('button--chip-active');

            // Filter posts
            posts.forEach((post) => {
              const postTags = post.dataset.tags?.split(',') || [];
              post.style.display = selectedTag === 'all' || postTags.includes(selectedTag) ? '' : 'none';
            });
          });
        });
      </script>
    )
  }
</section>
