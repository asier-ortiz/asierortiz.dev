---
---

<div id="shooting-stars-container" class="fixed inset-0 z-20 pointer-events-none overflow-hidden hidden md:block"></div>

<style is:global>
  .shooting-star {
    position: absolute;
    width: 120px;
    height: 2px;
    background: linear-gradient(to right, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0));
    border-radius: 999px;
    opacity: 0;
    animation: shoot 0.8s ease-out forwards;
  }

  .shooting-star::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: white;
    box-shadow: 0 0 6px 2px rgba(255, 255, 255, 0.6);
  }

  @keyframes shoot {
    0% {
      opacity: 1;
      transform: rotate(var(--angle)) translateX(0);
    }
    100% {
      opacity: 0;
      transform: rotate(var(--angle)) translateX(300px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shooting-star {
      animation: none;
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var timer = null;

    function createShootingStar() {
      var container = document.getElementById('shooting-stars-container');
      // Checked per spawn (not around the loop) so stars stop and resume with
      // the OS reduced-motion setting without needing a media query listener.
      if (
        !container ||
        document.hidden ||
        window.innerWidth < 768 ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        return;
      }

      var star = document.createElement('div');
      star.className = 'shooting-star';
      var angle = -(25 + Math.random() * 20);
      star.style.setProperty('--angle', angle + 'deg');
      star.style.top = Math.random() * 50 + '%';
      star.style.left = Math.random() * 70 + '%';

      container.appendChild(star);

      star.addEventListener('animationend', function () {
        star.remove();
      });

      // A reduced-motion toggle mid-flight cancels the animation instead of ending it.
      star.addEventListener('animationcancel', function () {
        star.remove();
      });
    }

    function scheduleNext() {
      // Only one chain of timers, whatever fires the reschedule.
      clearTimeout(timer);
      var delay = 8000 + Math.random() * 7000;
      timer = setTimeout(function () {
        createShootingStar();
        scheduleNext();
      }, delay);
    }

    // A hidden window paints no frames, so a star spawned while hidden never
    // starts its animation and never removes itself; they pile up and all
    // shoot at once on restore. Stop the loop while hidden, resume on return.
    function onVisibilityChange() {
      if (document.hidden) {
        clearTimeout(timer);
        timer = null;
        var container = document.getElementById('shooting-stars-container');
        if (container) container.textContent = '';
      } else {
        scheduleNext();
      }
    }

    if (typeof window !== 'undefined') {
      document.addEventListener('DOMContentLoaded', scheduleNext);
      document.addEventListener('visibilitychange', onVisibilityChange);
    }
  })();
</script>
