---
import { Icon } from 'astro-icon/components';
import ProjectGallery from '@components/Projects/ProjectGallery.astro';
import Button from '@components/Button/Button.astro';
import { type ProjectItem } from '@config/projectData.json';

interface Props extends ProjectItem {
  rest?: any;
}

const { images, title, description, href, languages, type, buttonText, buttonIcon, ...rest } =
  Astro.props as Props;
---

<div
  class="flex flex-col border-2 rounded border-base-700 p-4 project-container project-card"
  data-type={Array.isArray(type) ? type.join(',') : type}
  {...rest}
>
  <div class="mx-auto w-full max-w-4xl image-container">
    <ProjectGallery images={images} alt={title} />
  </div>
  <div class="mt-4 flex flex-grow flex-col justify-between">
    <div>
      <h2 class="h3">{title}</h2>
      <div class="languages-container">
        {
          languages.map((lang) => (
            <div class="language" key={lang.language}>
              <span class="language-bullet" style={{ backgroundColor: lang.color }} />
              <span>{lang.language}</span>
            </div>
          ))
        }
      </div>
      <p class="description mt-4">{description}</p>
    </div>
    <div class="mt-6 flex">
      {href ? (
        <Button
          variant="ghost"
          href={href}
          arrow="right"
          target="_blank"
          rel="noopener noreferrer"
          class="hover-button"
        >
          {buttonIcon && <Icon name={buttonIcon} class="h-5 w-5 mr-2" aria-hidden="true" />}
          {buttonText}
          <span class="sr-only">about {title}</span>
        </Button>
      ) : (
        <span class="button button--ghost disabled-button">
          {buttonIcon && <Icon name={buttonIcon} class="h-5 w-5 mr-2" aria-hidden="true" />}
          {buttonText}
        </span>
      )}
    </div>
  </div>
</div>

<style lang="scss">
  .language {
    display: flex;
    align-items: center;
    margin-right: 10px;
  }

  .language-bullet {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    margin-right: 5px;
  }

  .languages-container {
    display: flex;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .project-container {
    position: relative;
    overflow: hidden;
  }

  .disabled-button {
    opacity: 0.5;
    cursor: default;
    pointer-events: none;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {

    // Zoom the card's gallery while the visitor hovers the action button
    const buttons = document.querySelectorAll('.hover-button');
    buttons.forEach((button) => {
      const gallery = button.closest('.project-container')?.querySelector('.project-gallery');
      if (button && gallery) {
        // Mouse only: a tap would synthesise the enter and never the leave.
        button.addEventListener('pointerenter', (event) => {
          if (event.pointerType === 'mouse') gallery.classList.add('zoom');
        });
        button.addEventListener('pointerleave', () => {
          gallery.classList.remove('zoom');
        });
      }
    });
  });
</script>
