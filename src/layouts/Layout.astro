---
import '@/styles/global.scss';
import Nav from '@components/Nav/Nav.astro';
import Footer from '@components/Footer/Footer.astro';
import ScrollToTop from '@components/Button/ScrollToTop.astro';
import ShootingStar from '@components/Particles/ShootingStar.astro';
import siteData from '@config/siteData.json';
import { absoluteUrl } from '@/utils/absoluteUrl';

interface Props {
  title: string;
  description: string;
  image?: string;
  pubDate?: Date | string;
  updatedDate?: Date | string;
  isPost?: boolean;
}

const { title, description, image, pubDate, updatedDate, isPost } = Astro.props as Props;
const pageUrl = Astro.url;
const ogImage = absoluteUrl(image ?? siteData.defaultImage.src, Astro.site);
const published = pubDate ? new Date(pubDate) : undefined;
const modified = updatedDate ? new Date(updatedDate) : undefined;
---

<!doctype html>
<html lang={siteData.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="var(--theme-color)" />
    <link rel="canonical" href={pageUrl} />

    <!-- RSS / JSON Feed alternate links -->
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />
    <link rel="alternate" type="application/feed+json" title="JSON Feed" href="/feed.json" />

    <title>{title}</title>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={isPost ? 'article' : 'website'} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Article meta for blog posts -->
    {
      isPost && published && (
        <>
          <meta property="article:published_time" content={published.toISOString()} />
          {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
          <meta property="article:author" content={siteData.author.name} />
        </>
      )
    }

    <!-- JSON-LD Structured Data -->
    {
      !isPost ? (
        <script type="application/ld+json" set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@graph': [
            {
              '@type': 'WebSite',
              name: siteData.name,
              url: Astro.site,
              description: siteData.description,
            },
            {
              '@type': 'Person',
              name: siteData.author.name,
              url: Astro.site,
              email: siteData.author.email,
              sameAs: siteData.socialLinks
                .filter((l) => l.platform !== 'email' && l.platform !== 'rss')
                .map((l) => l.link),
              jobTitle: 'Full-Stack & Data Developer',
            },
          ],
        })} />
      ) : (
        <script type="application/ld+json" set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'BlogPosting',
          headline: title,
          description: description,
          url: pageUrl,
          image: ogImage,
          datePublished: published?.toISOString(),
          dateModified: (modified ?? published)?.toISOString(),
          author: {
            '@type': 'Person',
            name: siteData.author.name,
            url: Astro.site,
          },
          publisher: {
            '@type': 'Person',
            name: siteData.author.name,
            url: Astro.site,
          },
        })} />
      )
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body
    class:list={['dark overflow-y-scroll', { 'use-animations': siteData.useAnimations === true }]}
  >
    <div class="flex min-h-[100lvh] flex-col justify-between">
      <div>
        <Nav />
        <main>
          <slot />
        </main>
      </div>
      <Footer />
    </div>
    <ScrollToTop />
    {!isPost && <ShootingStar />}

    <!-- Initialize AOS animations if enabled in site config -->
    <script>
      import siteData from '@config/siteData.json';
      import AOS from '@js/aos/aos';

      if (siteData.useAnimations === true && typeof window !== 'undefined') {
        AOS.init({
          once: true,
          duration: 0.75,
          distance: 15,
          // When disabled, AOS strips the data-aos attributes, so the hide rules
          // in src/styles/aos.scss stop matching and content stays visible.
          // Evaluated once per full page load.
          disable: () => window.matchMedia('(prefers-reduced-motion: reduce)').matches,
        });
      }
    </script>


    <!-- Load Copy Code Script dynamically -->
    <script src={import.meta.env.DEV ? '/src/scripts/copy-code.js' : '/assets/scripts/copy-code.js'} type="module" defer is:inline></script>

  </body>
</html>
